# Rentora production settings. Rename this file to .env, fill the values, and
# upload it next to the .htaccess file. Never change APP_KEY after installing:
# saved secrets (Paystack, SMTP, SMS) are encrypted with it.
APP_NAME=Rentora
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=error

# From your hosting control panel (InfinityFree: sqlXXX.infinityfree.com).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# SMTP fallback. The owner normally enters these in Settings > Email.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Rentora
RENTORA_MULTI_ORG=false
# lazy on free hosting (no cron); cron on paid hosting with a cron job.
RENTORA_SCHEDULER_MODE=lazy
# Long random strings. The install key opens /install and /system/upgrade.
RENTORA_TICK_KEY=
RENTORA_INSTALL_KEY=
# true only on hosts that accept external POSTs (not InfinityFree).
RENTORA_PAYSTACK_WEBHOOKS=false
RENTORA_OUTBOX_BATCH=10
RENTORA_TICK_BUDGET_SECONDS=8
RENTORA_TICK_INTERVAL_MINUTES=5

# Fallbacks only; the owner enters live keys in Settings.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
SMS_DRIVER=log

# Android app (optional, see android-app/README.md).
ANDROID_PACKAGE_NAME=com.heisbayour.rentora
ANDROID_SHA256_FINGERPRINTS=
