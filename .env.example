APP_NAME=Rentora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 / MariaDB 10.4+ in production. For quick local work you may use
# DB_CONNECTION=sqlite (database/database.sqlite) instead.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rentora
DB_USERNAME=root
DB_PASSWORD=

# Shared hosting safe defaults: no Redis, no workers.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Email is SMTP only (PHP mail() is disabled on InfinityFree). Values here are a
# fallback; the owner normally enters SMTP details in Settings > Email.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Rentora
RENTORA_MULTI_ORG=false
# lazy (free hosting, no cron) | cron (paid hosting, server cron runs rentora:tick)
RENTORA_SCHEDULER_MODE=lazy
RENTORA_TICK_KEY=change-me-long-random
RENTORA_INSTALL_KEY=change-me-long-random
# true only on hosts that accept external POSTs (not InfinityFree)
RENTORA_PAYSTACK_WEBHOOKS=false
RENTORA_OUTBOX_BATCH=10
RENTORA_TICK_BUDGET_SECONDS=8
RENTORA_TICK_INTERVAL_MINUTES=5

# Fallbacks only. The owner enters live keys in Settings > Payments / SMS,
# where they are stored encrypted.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# log (default) | termii | twilio
SMS_DRIVER=log
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=generic
TERMII_BASE_URL=https://v3.api.termii.com
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

VITE_APP_NAME="${APP_NAME}"
